# Üretim ortam değişkenleri (docker-compose.prod.yml için).
# Sunucuda bu dosyayı ".env" olarak kopyalayıp değerleri DEĞİŞTİRİN:
#   cp .env.prod.example .env
# docker compose, aynı klasördeki .env dosyasını otomatik okur.

# Veritabanı parolaları
DB_PASSWORD=GucluBirDBParolasi
MYSQL_ROOT_PASSWORD=GucluBirRootParolasi

# Uygulama güvenliği
JWT_SECRET=cok-uzun-rastgele-gizli-anahtar-buraya
ADMIN_EMAIL=admin@havuz.local
ADMIN_PASSWORD=GucluBirAdminParolasi

# Alan adınızla sınırlayın (örn. https://teklif.sirketiniz.com). Test için * bırakılabilir.
CORS_ORIGIN=*

# Dışarı açılacak HTTP portu (arayüz)
HTTP_PORT=8080
