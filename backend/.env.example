# --- Sunucu ---
PORT=4000
NODE_ENV=development
# Frontend origin (CORS). Birden fazla için virgülle ayırın.
CORS_ORIGIN=http://localhost:5173

# --- Veritabanı (MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=havuz_teklif
DB_USER=havuz
DB_PASSWORD=havuz_parola
# Uygulama açılışında tabloları oluştur/güncelle (üretimde migration tercih edin)
DB_SYNC=true

# --- Kimlik doğrulama ---
JWT_SECRET=degistirin-bu-cok-gizli-bir-anahtar
JWT_EXPIRES_IN=12h

# --- İlk yönetici (seed) ---
ADMIN_EMAIL=admin@havuz.local
ADMIN_PASSWORD=Admin123!
ADMIN_NAME=Sistem Yoneticisi
